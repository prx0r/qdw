{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "qdw-review",
          "rules": [
            {
              "id": "QDW-FINAL-028",
              "name": "QDWSystem still lacks execution/review registries needed for closed-loop autonomy",
              "shortDescription": {
                "text": "Global intelligence services are now composed, but ExecutorRegistry, canonical VerificationService, ReviewService and autonomous convergence controller are absent."
              }
            },
            {
              "id": "QDW-FINAL-022",
              "name": "CI migration gate does not test the current migration set",
              "shortDescription": {
                "text": "The migration step only asserts versions 1 and 2; current repository has migrations 3 and 4."
              }
            },
            {
              "id": "QDW-FINAL-023",
              "name": "Docker is built but never booted",
              "shortDescription": {
                "text": "V9 runtime health is not proven: no docker run, /health, import, database migration or shutdown smoke."
              }
            },
            {
              "id": "QDW-FINAL-024",
              "name": "No remote CI/branch-protection evidence is bound to the current head",
              "shortDescription": {
                "text": "main is unprotected and no combined commit statuses were returned for the reviewed head."
              }
            },
            {
              "id": "QDW-FINAL-030",
              "name": "Commit message '29/29 findings addressed' is not supported by the implementation",
              "shortDescription": {
                "text": "Several earlier invariants remain unresolved: atomic provenance, real API fixture, real execution E2E, exact certificate binding and append-only cemetery history."
              }
            },
            {
              "id": "QDW-FINAL-020",
              "name": "Integration E2E still bypasses execution/certification",
              "shortDescription": {
                "text": "The flow connects world/intelligence/ideas/product services but does not prove FactoryRun\u2192WorkGraph\u2192HotSwap\u2192Executor\u2192Artifact\u2192independent contractor\u2192BuildCertificate\u2192release."
              }
            },
            {
              "id": "QDW-FINAL-019",
              "name": "The API factory fixture is still simulated, not an API fixture",
              "shortDescription": {
                "text": "The fixture never generates files or boots HTTP. It manually completes nodes with status_code=200 and feeds {'ok': True} into a lambda gate."
              }
            },
            {
              "id": "QDW-FINAL-016",
              "name": "Route persistence is lossy",
              "shortDescription": {
                "text": "save/load persists only a subset of Route: endpoint_id, account_id, prior_success, prior_confidence, breaker_open, quota_pressure and evidence_ids are lost on restart."
              }
            },
            {
              "id": "QDW-FINAL-017",
              "name": "register_route can create duplicate in-memory routes",
              "shortDescription": {
                "text": "register_route always appends to self.routes while save_route upserts the DB. Re-registering a route_id can produce duplicate candidates until restart."
              }
            },
            {
              "id": "QDW-FINAL-018",
              "name": "First-use posterior initialization can overwrite concurrent learning",
              "shortDescription": {
                "text": "get() calls _upsert with ON CONFLICT DO UPDATE. A concurrent initializer can replace a posterior that another worker just updated."
              }
            },
            {
              "id": "QDW-FINAL-025",
              "name": "Cemetery re-bury still deletes the previous structured episode",
              "shortDescription": {
                "text": "When an entry is REVIVED, bury deletes the old cemetery row before inserting the new one, so historical burial assumptions are not preserved in the structured table."
              }
            },
            {
              "id": "QDW-FINAL-013",
              "name": "Migration application and version/hash recording are not atomic",
              "shortDescription": {
                "text": "executescript(sql) is followed by schema_versions INSERT without an explicit tested transaction covering both. A halfway failure can leave partial schema with no applied-version row."
              }
            },
            {
              "id": "QDW-FINAL-014",
              "name": "Legacy applied migrations with NULL content_hash remain outside drift protection",
              "shortDescription": {
                "text": "_check_drift only rejects when stored content_hash is non-null; legacy version rows are not securely backfilled."
              }
            },
            {
              "id": "QDW-FINAL-015",
              "name": "Migration 0004 is a destructive table-rebuild without upgrade/failure parity proof",
              "shortDescription": {
                "text": "It rebuilds and drops many global tables. CI only checks versions 1 and 2 and does not prove populated 1\u21922\u21923\u21924 upgrade parity, row preservation, indexes, or rollback on failure."
              }
            },
            {
              "id": "QDW-FINAL-026",
              "name": "Outcome source enum is not outcome authority",
              "shortDescription": {
                "text": "manual/analytics/api/observation/experiment strings are validated, but fixture/test/estimated/measured authority and learning eligibility are not enforced."
              }
            },
            {
              "id": "QDW-FINAL-027",
              "name": "Factory-created and manually imported products still share one permissive constructor",
              "shortDescription": {
                "text": "factory_id/version/build_run_id remain optional with only documentation saying manual products are allowed."
              }
            },
            {
              "id": "QDW-FINAL-029",
              "name": "Generated review pack/ZIP are committed as duplicate source artifacts",
              "shortDescription": {
                "text": "Keeping a nested old implementation pack in the source repo creates stale duplicate code and review confusion."
              }
            },
            {
              "id": "QDW-FINAL-021",
              "name": "The self-review system is stored as an imported artifact, not integrated as QDW runtime",
              "shortDescription": {
                "text": "The previous review pack and ZIP are committed, but no native src/qdw/review service exists. QDW cannot autonomously invoke or persist review runs."
              }
            },
            {
              "id": "QDW-FINAL-007",
              "name": "Factory activation still uses a gate_result as a certificate",
              "shortDescription": {
                "text": "Activation checks passed + detail_json.factory_id and an optional factory_version. It does not bind fixture_id, factory definition hash, artifact digests, acceptance plan, build run or independent certifier."
              }
            },
            {
              "id": "QDW-FINAL-008",
              "name": "Contractor activation still uses a gate_result as a certificate",
              "shortDescription": {
                "text": "Contractor activation mirrors the weak gate_result pattern and allows missing contractor_version."
              }
            },
            {
              "id": "QDW-FINAL-009",
              "name": "Product release still uses gate_results instead of a release certificate",
              "shortDescription": {
                "text": "Release checks detail_json.product_id but not build_run_id, certified artifact set, factory definition, build certificate, review certificate or release policy."
              }
            },
            {
              "id": "QDW-FINAL-001",
              "name": "Two verification runners own incompatible receipt formats",
              "shortDescription": {
                "text": "CLI writes core VerificationRunner run directories; BuildCertificateBuilder reads proof/runner receipts.jsonl. They are separate sources of verification truth."
              }
            },
            {
              "id": "QDW-FINAL-002",
              "name": "CI Build Certificate is not bound to the pytest/lint/type-check gates",
              "shortDescription": {
                "text": "CI executes pytest/ruff/pyright directly, then runs one CLI smoke through the other verification runner. build_certificate.py reads qdw.proof receipts, so the preceding gates are not the certificate's mandatory receipt set."
              }
            },
            {
              "id": "QDW-FINAL-003",
              "name": "Build certificate derives its requirements from whatever receipts happened to exist",
              "shortDescription": {
                "text": "The script chooses the most common task_id, converts observed receipt argv into required_commands, and uses acceptance_spec_hash='ci_pipeline'. The acceptance criteria are therefore not frozen before execution."
              }
            },
            {
              "id": "QDW-FINAL-004",
              "name": "Negative-test semantics are inverted",
              "shortDescription": {
                "text": "required_negative_tests are considered successful only when the process exits nonzero. A proper pytest adversarial test should exit 0 while asserting that malicious input was rejected."
              }
            },
            {
              "id": "QDW-FINAL-005",
              "name": "Certificate issuance does not enforce one clean exact Git subject across receipts",
              "shortDescription": {
                "text": "Receipt lookup is by argv/task_id; certificate git_sha comes from receipts[0]. It does not reject mixed SHAs, dirty receipts, or different working directories/environments."
              }
            },
            {
              "id": "QDW-FINAL-006",
              "name": "Certificate revalidation reruns changed code instead of validating the original evidence set",
              "shortDescription": {
                "text": "verify_certificate re-executes commands in cert.get('cwd','.'), but cwd is not stored in the certificate. It does not validate the actual acceptance-spec file and can verify a later checkout rather than the certified subject."
              }
            },
            {
              "id": "QDW-FINAL-010",
              "name": "Atomic provenance was fixed only for create_graph",
              "shortDescription": {
                "text": "add_node, add_edge, refresh_ready, reclaim_stale, claim_ready, start, verifying, complete and fail still commit canonical state before ledger.append."
              }
            },
            {
              "id": "QDW-FINAL-011",
              "name": "Cycle rejection occurs after the edge has already committed",
              "shortDescription": {
                "text": "add_edge inserts/commits an edge, then validate_dag raises if cyclic. The invalid cyclic edge remains in canonical state."
              }
            },
            {
              "id": "QDW-FINAL-012",
              "name": "WorkGraphs have no enforced freeze boundary",
              "shortDescription": {
                "text": "Nodes/edges can be modified while a graph is executable; DAG validation is not tied to a DRAFT\u2192FROZEN lifecycle/hash."
              }
            }
          ]
        }
      },
      "results": [
