{
  "formula_id": "review.full",
  "version": "2.0.0",
  "description": "Full QDW peer-review formula. Expands onto normal WorkGraph.",
  "stages": [
    {
      "id": "static",
      "kind": "deterministic",
      "service": "review.static"
    },
    {
      "id": "specialists",
      "kind": "parallel_reviewers",
      "depends_on": [
        "static"
      ],
      "reviewers": [
        "review.architecture",
        "review.verification",
        "review.trust",
        "review.provenance",
        "review.database",
        "review.migrations",
        "review.workgraph",
        "review.concurrency",
        "review.hotswap",
        "review.economics",
        "review.factory",
        "review.contractor",
        "review.sources",
        "review.world",
        "review.intelligence",
        "review.ideas",
        "review.products",
        "review.human",
        "review.publishing",
        "review.interfaces",
        "review.security",
        "review.dependencies",
        "review.ci",
        "review.performance",
        "review.observability",
        "review.test-quality",
        "review.e2e",
        "review.self-review"
      ]
    },
    {
      "id": "attacks",
      "kind": "attack_catalog",
      "depends_on": [
        "specialists"
      ]
    },
    {
      "id": "claim_consistency",
      "kind": "reviewer",
      "reviewer": "review.claim-consistency",
      "depends_on": [
        "specialists",
        "attacks"
      ]
    },
    {
      "id": "certify",
      "kind": "independent_certifier",
      "service": "review.release-certifier",
      "depends_on": [
        "claim_consistency"
      ]
    }
  ],
  "invariant": "Formula is a planning template only; WorkGraph remains canonical scheduler truth."
}