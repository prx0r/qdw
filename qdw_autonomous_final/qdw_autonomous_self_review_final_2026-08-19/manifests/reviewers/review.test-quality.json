{
  "contractor_id": "review.test-quality",
  "version": "2.0.0",
  "team": "peer_review",
  "specialization": "test_quality",
  "description": "Audit fake-green patterns, assertion quality, fixture realism, mutation sensitivity and mandatory skip counts.",
  "enabled": true,
  "always": true,
  "path_patterns": [
    "tests/**",
    "src/qdw/proof/test_guard.py"
  ],
  "inputs": [
    "subject_git_sha",
    "changed_paths",
    "review_policy",
    "repo_snapshot"
  ],
  "outputs": [
    "review_result"
  ],
  "gates": [
    "typed_findings",
    "evidence_required",
    "acceptance_required_for_blockers"
  ],
  "default_budget_usd": 0.08,
  "quality_floor": 0.8,
  "timeout_seconds": 900,
  "required_capabilities": [
    "repo_read",
    "reasoning"
  ],
  "prompt_file": "review.test-quality.md",
  "independence": {
    "may_self_certify": false,
    "may_review_own_producer_run": false,
    "release_certifier": false
  },
  "fixture": {
    "fixture_id": "review.test-quality.contract.v2",
    "kind": "reviewer_contract",
    "verifier": "scripts/verify_reviewer_manifest.py"
  }
}