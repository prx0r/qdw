{
  "contractor_id": "review.architecture",
  "version": "2.0.0",
  "team": "peer_review",
  "specialization": "architecture",
  "description": "Map ownership, composition, dependency direction, duplicate truth, dead islands and full economic/product lineage.",
  "enabled": true,
  "always": true,
  "path_patterns": [
    "src/qdw/**",
    "migrations/**",
    "manifests/**"
  ],
  "inputs": [
    "subject_git_sha",
    "changed_paths",
    "review_policy",
    "repo_snapshot"
  ],
  "outputs": [
    "review_result"
  ],
  "gates": [
    "typed_findings",
    "evidence_required",
    "acceptance_required_for_blockers"
  ],
  "default_budget_usd": 0.12,
  "quality_floor": 0.8,
  "timeout_seconds": 1200,
  "required_capabilities": [
    "repo_read",
    "reasoning"
  ],
  "prompt_file": "review.architecture.md",
  "independence": {
    "may_self_certify": false,
    "may_review_own_producer_run": false,
    "release_certifier": false
  },
  "fixture": {
    "fixture_id": "review.architecture.contract.v2",
    "kind": "reviewer_contract",
    "verifier": "scripts/verify_reviewer_manifest.py"
  }
}