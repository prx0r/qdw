{
  "contractor_id": "review.release-certifier",
  "version": "2.0.0",
  "team": "peer_review",
  "specialization": "release_certifier",
  "description": "Aggregate evidence only. Never implement fixes. Issue REVIEW_CERTIFIED only for exact policy/SHA with zero blockers.",
  "enabled": true,
  "always": true,
  "path_patterns": [
    "**"
  ],
  "inputs": [
    "subject_git_sha",
    "changed_paths",
    "review_policy",
    "repo_snapshot"
  ],
  "outputs": [
    "review_result"
  ],
  "gates": [
    "typed_findings",
    "evidence_required",
    "acceptance_required_for_blockers"
  ],
  "default_budget_usd": 0.05,
  "quality_floor": 0.8,
  "timeout_seconds": 900,
  "required_capabilities": [
    "repo_read",
    "reasoning"
  ],
  "prompt_file": "review.release-certifier.md",
  "independence": {
    "may_self_certify": false,
    "may_review_own_producer_run": false,
    "release_certifier": true
  },
  "fixture": {
    "fixture_id": "review.release-certifier.contract.v2",
    "kind": "reviewer_contract",
    "verifier": "scripts/verify_reviewer_manifest.py"
  }
}