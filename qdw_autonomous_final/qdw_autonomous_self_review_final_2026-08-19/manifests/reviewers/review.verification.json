{
  "contractor_id": "review.verification",
  "version": "2.0.0",
  "team": "peer_review",
  "specialization": "verification",
  "description": "Audit frozen plans, receipts, exact Git subjects, artifact evidence, attack semantics and certificate verification.",
  "enabled": true,
  "always": true,
  "path_patterns": [
    "src/qdw/proof/**",
    "src/qdw/core/verification/**",
    "scripts/**",
    ".github/**"
  ],
  "inputs": [
    "subject_git_sha",
    "changed_paths",
    "review_policy",
    "repo_snapshot"
  ],
  "outputs": [
    "review_result"
  ],
  "gates": [
    "typed_findings",
    "evidence_required",
    "acceptance_required_for_blockers"
  ],
  "default_budget_usd": 0.08,
  "quality_floor": 0.8,
  "timeout_seconds": 900,
  "required_capabilities": [
    "repo_read",
    "reasoning"
  ],
  "prompt_file": "review.verification.md",
  "independence": {
    "may_self_certify": false,
    "may_review_own_producer_run": false,
    "release_certifier": false
  },
  "fixture": {
    "fixture_id": "review.verification.contract.v2",
    "kind": "reviewer_contract",
    "verifier": "scripts/verify_reviewer_manifest.py"
  }
}