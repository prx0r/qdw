{
  "contractor_id": "review.migrations",
  "version": "2.0.0",
  "team": "peer_review",
  "specialization": "migrations",
  "description": "Audit immutable migration digests, fresh/upgrade parity, row preservation, atomic failure and schema fingerprints.",
  "enabled": true,
  "always": false,
  "path_patterns": [
    "migrations/**",
    "src/qdw/core/migrations.py"
  ],
  "inputs": [
    "subject_git_sha",
    "changed_paths",
    "review_policy",
    "repo_snapshot"
  ],
  "outputs": [
    "review_result"
  ],
  "gates": [
    "typed_findings",
    "evidence_required",
    "acceptance_required_for_blockers"
  ],
  "default_budget_usd": 0.08,
  "quality_floor": 0.75,
  "timeout_seconds": 900,
  "required_capabilities": [
    "repo_read",
    "reasoning"
  ],
  "prompt_file": "review.migrations.md",
  "independence": {
    "may_self_certify": false,
    "may_review_own_producer_run": false,
    "release_certifier": false
  },
  "fixture": {
    "fixture_id": "review.migrations.contract.v2",
    "kind": "reviewer_contract",
    "verifier": "scripts/verify_reviewer_manifest.py"
  }
}