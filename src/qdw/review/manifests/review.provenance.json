{
  "contractor_id": "review.provenance",
  "version": "2.0.0",
  "team": "peer_review",
  "specialization": "provenance",
  "description": "Audit state/event atomicity, append-only history, content hashes, ledger/Merkle linkage and crash windows.",
  "enabled": true,
  "always": false,
  "path_patterns": [
    "src/qdw/**",
    "migrations/**"
  ],
  "inputs": [
    "subject_git_sha",
    "changed_paths",
    "review_policy",
    "repo_snapshot"
  ],
  "outputs": [
    "review_result"
  ],
  "gates": [
    "typed_findings",
    "evidence_required",
    "acceptance_required_for_blockers"
  ],
  "default_budget_usd": 0.08,
  "quality_floor": 0.75,
  "timeout_seconds": 900,
  "required_capabilities": [
    "repo_read",
    "reasoning"
  ],
  "prompt_file": "review.provenance.md",
  "independence": {
    "may_self_certify": false,
    "may_review_own_producer_run": false,
    "release_certifier": false
  },
  "fixture": {
    "fixture_id": "review.provenance.contract.v2",
    "kind": "reviewer_contract",
    "verifier": "scripts/verify_reviewer_manifest.py"
  }
}