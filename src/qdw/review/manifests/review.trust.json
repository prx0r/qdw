{
  "contractor_id": "review.trust",
  "version": "2.0.0",
  "team": "peer_review",
  "specialization": "trust",
  "description": "Perform evidence-substitution analysis. A valid ID for the wrong subject/version/run/artifact must never authorize a transition.",
  "enabled": true,
  "always": true,
  "path_patterns": [
    "src/qdw/factories/**",
    "src/qdw/contractors/**",
    "src/qdw/products/**",
    "src/qdw/human/**",
    "src/qdw/review/**"
  ],
  "inputs": [
    "subject_git_sha",
    "changed_paths",
    "review_policy",
    "repo_snapshot"
  ],
  "outputs": [
    "review_result"
  ],
  "gates": [
    "typed_findings",
    "evidence_required",
    "acceptance_required_for_blockers"
  ],
  "default_budget_usd": 0.1,
  "quality_floor": 0.8,
  "timeout_seconds": 900,
  "required_capabilities": [
    "repo_read",
    "reasoning"
  ],
  "prompt_file": "review.trust.md",
  "independence": {
    "may_self_certify": false,
    "may_review_own_producer_run": false,
    "release_certifier": false
  },
  "fixture": {
    "fixture_id": "review.trust.contract.v2",
    "kind": "reviewer_contract",
    "verifier": "scripts/verify_reviewer_manifest.py"
  }
}