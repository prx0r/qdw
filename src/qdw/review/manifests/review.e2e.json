{
  "contractor_id": "review.e2e",
  "version": "2.0.0",
  "team": "peer_review",
  "specialization": "e2e",
  "description": "Require a real source\u2192factory\u2192WorkGraph\u2192route\u2192executor\u2192artifact\u2192certificate\u2192release\u2192outcome path.",
  "enabled": true,
  "always": true,
  "path_patterns": [
    "tests/integration/**",
    "tests/e2e/**",
    "src/qdw/system.py"
  ],
  "inputs": [
    "subject_git_sha",
    "changed_paths",
    "review_policy",
    "repo_snapshot"
  ],
  "outputs": [
    "review_result"
  ],
  "gates": [
    "typed_findings",
    "evidence_required",
    "acceptance_required_for_blockers"
  ],
  "default_budget_usd": 0.1,
  "quality_floor": 0.8,
  "timeout_seconds": 900,
  "required_capabilities": [
    "repo_read",
    "reasoning"
  ],
  "prompt_file": "review.e2e.md",
  "independence": {
    "may_self_certify": false,
    "may_review_own_producer_run": false,
    "release_certifier": false
  },
  "fixture": {
    "fixture_id": "review.e2e.contract.v2",
    "kind": "reviewer_contract",
    "verifier": "scripts/verify_reviewer_manifest.py"
  }
}