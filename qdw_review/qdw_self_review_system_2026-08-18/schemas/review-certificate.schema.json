{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "subject_git_sha",
    "policy_hash",
    "aggregate_report_hash",
    "reviewer_set_hash",
    "attack_set_hash",
    "status",
    "certificate_hash"
  ],
  "properties": {
    "subject_git_sha": {
      "type": "string",
      "minLength": 7
    },
    "policy_hash": {
      "type": "string"
    },
    "aggregate_report_hash": {
      "type": "string"
    },
    "reviewer_set_hash": {
      "type": "string"
    },
    "attack_set_hash": {
      "type": "string"
    },
    "status": {
      "enum": [
        "REVIEW_CERTIFIED",
        "REVIEW_REJECTED"
      ]
    },
    "certificate_hash": {
      "type": "string"
    }
  }
}