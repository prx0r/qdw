{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QDW Review Finding",
  "type": "object",
  "required": [
    "rule_id",
    "module_id",
    "severity",
    "title",
    "summary",
    "invariant",
    "evidence",
    "remediation",
    "acceptance_tests"
  ],
  "properties": {
    "finding_id": {
      "type": "string"
    },
    "rule_id": {
      "type": "string"
    },
    "module_id": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW",
        "INFO"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "invariant": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "status": {
      "enum": [
        "OPEN",
        "ACKNOWLEDGED",
        "FIXED",
        "REGRESSION",
        "SUPPRESSED",
        "WONT_FIX"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "remediation": {
      "type": "string"
    },
    "acceptance_tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}