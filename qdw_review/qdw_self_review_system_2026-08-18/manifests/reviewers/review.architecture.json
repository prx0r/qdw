{
  "contractor_id": "review.architecture",
  "version": "1.0.0",
  "team": "peer_review",
  "specialization": "architecture",
  "description": "System boundaries, composition root, ownership, coupling, dead islands",
  "inputs": [
    "repo_snapshot",
    "git_sha",
    "review_policy",
    "changed_paths"
  ],
  "outputs": [
    "architecture_map",
    "findings"
  ],
  "gates": [
    "composition_unique",
    "no_private_canonical_state"
  ],
  "default_budget_usd": 0.15,
  "independence": {
    "may_review_own_producer_run": false,
    "may_issue_release_certificate": false,
    "requires_distinct_worker_for_release": true
  },
  "evidence_contract": {
    "finding_requires": [
      "rule_id",
      "severity",
      "invariant",
      "evidence",
      "remediation",
      "acceptance_tests"
    ],
    "verified_dynamic_claim_requires": [
      "command_receipt_id"
    ],
    "pass_boolean_is_evidence": false,
    "missing_evidence_status": "UNVERIFIED"
  }
}