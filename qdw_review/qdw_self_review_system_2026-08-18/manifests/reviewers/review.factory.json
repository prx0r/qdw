{
  "contractor_id": "review.factory",
  "version": "1.0.0",
  "team": "peer_review",
  "specialization": "factory",
  "description": "Factory manifest/plan/run/fixture/certificate lifecycle and real artifact production",
  "inputs": [
    "repo_snapshot",
    "git_sha",
    "review_policy",
    "changed_paths"
  ],
  "outputs": [
    "factory_report",
    "findings"
  ],
  "gates": [
    "fixture_real",
    "activation_bound"
  ],
  "default_budget_usd": 0.05,
  "independence": {
    "may_review_own_producer_run": false,
    "may_issue_release_certificate": false,
    "requires_distinct_worker_for_release": true
  },
  "evidence_contract": {
    "finding_requires": [
      "rule_id",
      "severity",
      "invariant",
      "evidence",
      "remediation",
      "acceptance_tests"
    ],
    "verified_dynamic_claim_requires": [
      "command_receipt_id"
    ],
    "pass_boolean_is_evidence": false,
    "missing_evidence_status": "UNVERIFIED"
  }
}