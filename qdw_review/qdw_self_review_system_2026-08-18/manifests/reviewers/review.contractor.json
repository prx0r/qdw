{
  "contractor_id": "review.contractor",
  "version": "1.0.0",
  "team": "peer_review",
  "specialization": "contractor",
  "description": "Global contractor versions, specialization, independence and reusable quality standards",
  "inputs": [
    "repo_snapshot",
    "git_sha",
    "review_policy",
    "changed_paths"
  ],
  "outputs": [
    "contractor_report",
    "findings"
  ],
  "gates": [
    "version_immutable",
    "activation_certified"
  ],
  "default_budget_usd": 0.05,
  "independence": {
    "may_review_own_producer_run": false,
    "may_issue_release_certificate": false,
    "requires_distinct_worker_for_release": true
  },
  "evidence_contract": {
    "finding_requires": [
      "rule_id",
      "severity",
      "invariant",
      "evidence",
      "remediation",
      "acceptance_tests"
    ],
    "verified_dynamic_claim_requires": [
      "command_receipt_id"
    ],
    "pass_boolean_is_evidence": false,
    "missing_evidence_status": "UNVERIFIED"
  }
}