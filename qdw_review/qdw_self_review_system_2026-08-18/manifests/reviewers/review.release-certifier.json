{
  "contractor_id": "review.release-certifier",
  "version": "1.0.0",
  "team": "peer_review",
  "specialization": "certifier",
  "description": "Aggregate independent reviewer outputs and issue/deny Review Certificate",
  "inputs": [
    "repo_snapshot",
    "git_sha",
    "review_policy",
    "changed_paths"
  ],
  "outputs": [
    "review_certificate"
  ],
  "gates": [
    "all_required_reviewers",
    "zero_blockers"
  ],
  "default_budget_usd": 0.05,
  "independence": {
    "may_review_own_producer_run": false,
    "may_issue_release_certificate": true,
    "requires_distinct_worker_for_release": true
  },
  "evidence_contract": {
    "finding_requires": [
      "rule_id",
      "severity",
      "invariant",
      "evidence",
      "remediation",
      "acceptance_tests"
    ],
    "verified_dynamic_claim_requires": [
      "command_receipt_id"
    ],
    "pass_boolean_is_evidence": false,
    "missing_evidence_status": "UNVERIFIED"
  }
}