{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "qdw-review",
          "rules": [
            {
              "id": "QDW-CUR-016",
              "name": "QDWSystem is not yet the claimed single composition root",
              "shortDescription": {
                "text": "Global World/Pain/Stack/Ideas/Human/Contractors/Products/Watch/Catalog services are not composed there."
              }
            },
            {
              "id": "QDW-CUR-019",
              "name": "Docker is built but not booted in CI",
              "shortDescription": {
                "text": "CI has docker build but no docker run and /health verification."
              }
            },
            {
              "id": "QDW-CUR-020",
              "name": "Pyright is configured but not run in CI",
              "shortDescription": {
                "text": "pyproject has Pyright config; workflow does not execute it."
              }
            },
            {
              "id": "QDW-CUR-005",
              "name": "Contractor versions are mutable",
              "shortDescription": {
                "text": "ON CONFLICT(contractor_id,version) DO UPDATE rewrites manifest/hash."
              }
            },
            {
              "id": "QDW-CUR-006",
              "name": "Contractor activation has no fixture/certificate gate",
              "shortDescription": {
                "text": "activate only flips CANDIDATE to ACTIVE."
              }
            },
            {
              "id": "QDW-CUR-018",
              "name": "Docker installation order is structurally wrong",
              "shortDescription": {
                "text": "pip install . runs before COPY src/, so the package source is absent at installation time."
              }
            },
            {
              "id": "QDW-CUR-017",
              "name": "Current E2E bypasses the factory execution spine",
              "shortDescription": {
                "text": "Flow goes source\u2192pain\u2192opportunity\u2192idea\u2192ProductRegistry directly; no FactoryRun, WorkGraph executor, artifact, certificate or release."
              }
            },
            {
              "id": "QDW-CUR-008",
              "name": "UNKNOWN graph economics are still fabricated",
              "shortDescription": {
                "text": "None expected_value becomes 1.0 and None expected_cost becomes 0.0 despite comment claiming unknown preservation."
              }
            },
            {
              "id": "QDW-CUR-003",
              "name": "Factory activation is vulnerable to evidence substitution",
              "shortDescription": {
                "text": "fixture_certificate_id is looked up in gate_results and only passed is checked; no factory/version/fixture/artifact binding."
              }
            },
            {
              "id": "QDW-CUR-029",
              "name": "main is not protected",
              "shortDescription": {
                "text": "GitHub branch metadata shows protected=false and no required checks."
              }
            },
            {
              "id": "QDW-CUR-013",
              "name": "Route definitions do not survive QDWSystem restart",
              "shortDescription": {
                "text": "self.routes initializes to [] every process even though route_definitions table exists."
              }
            },
            {
              "id": "QDW-CUR-014",
              "name": "Persistent posterior update can lose concurrent observations",
              "shortDescription": {
                "text": "read current posterior and later upsert are not one atomic increment transaction."
              }
            },
            {
              "id": "QDW-CUR-015",
              "name": "Quota state remains process-local",
              "shortDescription": {
                "text": "QuotaLedger has no canonical DB persistence while routing economics depend on it."
              }
            },
            {
              "id": "QDW-CUR-024",
              "name": "Human approval lacks required actor identity",
              "shortDescription": {
                "text": "Decision payload is arbitrary; no required principal/actor/source metadata."
              }
            },
            {
              "id": "QDW-CUR-022",
              "name": "Cemetery history is overwritten",
              "shortDescription": {
                "text": "ON CONFLICT(idea_id) DO UPDATE rewrites previous burial assumptions/triggers."
              }
            },
            {
              "id": "QDW-CUR-023",
              "name": "Idea review still trusts passed=True",
              "shortDescription": {
                "text": "Caller boolean is directly converted to PASS/BUILD_READY."
              }
            },
            {
              "id": "QDW-CUR-026",
              "name": "Outcome authority is not typed",
              "shortDescription": {
                "text": "Arbitrary manual/source outcomes can be recorded without learning eligibility/authority class."
              }
            },
            {
              "id": "QDW-CUR-009",
              "name": "Migration 0002 was edited after being introduced",
              "shortDescription": {
                "text": "Persistent HotSwap tables were appended to existing migration 0002; DBs that already recorded version 2 will skip them."
              }
            },
            {
              "id": "QDW-CUR-010",
              "name": "Migration versions have no checksum lock",
              "shortDescription": {
                "text": "schema_versions stores only version; migration content drift is undetectable."
              }
            },
            {
              "id": "QDW-CUR-011",
              "name": "Migration execution/version recording not proven atomic",
              "shortDescription": {
                "text": "executescript(sql) and schema_versions insert lack explicit single transactional envelope/failure test."
              }
            },
            {
              "id": "QDW-CUR-012",
              "name": "Database.migrate ignores migrations_dir parameter",
              "shortDescription": {
                "text": "migrations_dir accepted but migrate_all(self) called without it."
              }
            },
            {
              "id": "QDW-CUR-004",
              "name": "Product release accepts arbitrary certificate ID",
              "shortDescription": {
                "text": "release writes certificate_id without validating certificate existence or subject/run binding."
              }
            },
            {
              "id": "QDW-CUR-025",
              "name": "Factory-produced product lineage is optional",
              "shortDescription": {
                "text": "factory_id/version/build_run_id all optional in generic create."
              }
            },
            {
              "id": "QDW-CUR-001",
              "name": "Release certificate script is still vacuous",
              "shortDescription": {
                "text": "Uses acceptance_spec_hash='manual_review', required_commands=[], required_negative_tests=[]; unrelated latest receipt can seed PROVEN."
              }
            },
            {
              "id": "QDW-CUR-002",
              "name": "Certificate verifier does not revalidate bound evidence",
              "shortDescription": {
                "text": "verify_certificate checks envelope hash/status only; it does not recompute artifacts, receipt logs or acceptance spec."
              }
            },
            {
              "id": "QDW-CUR-007",
              "name": "State and ledger events are still separate commits",
              "shortDescription": {
                "text": "Graph/node state transactions commit before self.ledger.append; crash window remains."
              }
            },
            {
              "id": "QDW-CUR-021",
              "name": "Global lineage tables largely lack foreign keys",
              "shortDescription": {
                "text": "Ideas, decisions, cemetery, human actions, products, genomes, publications, outcomes and contractor relations use unbound TEXT IDs."
              }
            },
            {
              "id": "QDW-CUR-027",
              "name": "DAG validator is not an execution gate",
              "shortDescription": {
                "text": "validate_dag exists but claim_ready does not require graph validation/freeze."
              }
            },
            {
              "id": "QDW-CUR-028",
              "name": "Retry ceiling semantics differ by failure path",
              "shortDescription": {
                "text": "fail uses <= max_retries while stale reclaim uses >= max_retries."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "QDW-CUR-016",
          "level": "error",
          "message": {
            "text": "Global World/Pain/Stack/Ideas/Human/Contractors/Products/Watch/Catalog services are not composed there."
          },
